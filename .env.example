# Installation settings. Copy to .env (./install.sh does it), adapt, then "docker compose up -d".
# An empty or commented-out line keeps the default value. Guide: docs/installation.md
# (.env files created by an earlier version use the former French names: they are still accepted.)

# ---- Address
# Domain name (or IP address) used to open the tool; several: separated by commas.
# localhost is always allowed. Without DOMAIN: only http://localhost:8000 on the server itself.
DOMAIN=
# HTTPS: 1 behind Caddy ("https" profile) or another HTTPS proxy: secure cookies, redirection, HSTS.
DJANGO_HTTPS=0
# HTTP port of the tool on the server (8000). With Caddy: 127.0.0.1:8000 to expose it only to Caddy.
HTTP_PORT=8000
# docker compose profiles: "https" adds Caddy (automatic certificate), "postgres" adds PostgreSQL.
COMPOSE_PROFILES=

# ---- Company network (docs/installation.md, "Company network")
# HTTPS certificate given by the IT instead of the automatic one ("https" profile): files = the files
# certificates/https/certificate.pem (with the intermediate certificates) and certificates/https/key.pem, put there by
# ./install.sh --cert --key. Caddy then never asks Let's Encrypt. Empty: automatic certificate.
HTTPS_CERTIFICATE=
# Certificate authorities of the company for the outgoing connections of the tool (email server, HTTPS through a proxy
# that inspects the traffic): PEM files in the folder certificates/ca (./install.sh --ca-cert). With Docker, nothing to
# set here. Without Docker (managed hosting, runserver): EXTRA_CA_CERTS=<file or folder>, several separated by ":".

# ---- Database
# Empty: SQLite in the data volume (recommended up to a few dozen users).
# PostgreSQL: DATABASE_URL=postgres://probant:PASSWORD@db:5432/probant (with the "postgres" profile),
# or the address of an existing PostgreSQL server.
DATABASE_URL=
POSTGRES_PASSWORD=change-me

# ---- Security
# Empty: a key is generated at first start and kept in the data volume (/data/.secret_key).
DJANGO_SECRET_KEY=
# HSTS (with DJANGO_HTTPS=1): duration in seconds, subdomains included (1/0), "preload" registration (0/1).
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0
# Content security policy of the pages: enforce (default) or report-only (the browser reports what it would block, in
# its console, and blocks nothing). Use report-only only for a short time, if a screen breaks (docs/installation.md).
CONTENT_SECURITY_POLICY_MODE=enforce

# ---- E-mails (SMTP). Usually left empty: a space manager or an administrator of the main space then sets the
# sending server in the tool (Administration › Settings › Hosting, "Emails" box). When SMTP_HOST is set, these values
# take priority over the settings of the tool. Nothing set anywhere: nothing is sent, e-mails go to the server log.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reporting@example.com

# ---- AI assistant (optional, docs/ai_socket.md). Off in every space until an administrator turns it on with the
# client's key (Administration › Settings › AI assistant). The server then needs outgoing HTTPS to api.anthropic.com.
# off: turned off for the whole installation (no AI button, nothing sent). Through a proxy: HTTPS_PROXY=http://host:port
AI_SOCKET=on

# Address of the tool in automatic reminders (link to "For me"); empty: derived from DOMAIN and DJANGO_HTTPS.
PUBLIC_URL=
# Time at which automatic reminders are checked (enabled in Dashboard › Reminders), TIME_ZONE time zone.
REMINDER_TIME=09:00

# ---- Language
# Language of a new installation (interface and contents, for people who have not chosen theirs): en (default), fr, es, de, it, nl or pt.
# Read only when the database is created; afterwards, change it in the tool (Administration › Settings › Languages).
DEFAULT_LANGUAGE=en

# Short guided tour at the first sign-in (display only): on (default) or off.
# GUIDED_TOUR=on

# ---- Time zone
# IANA name, for example Europe/Paris or America/New_York (empty: Europe/Brussels). The times of the automatic reminders,
# of the automatic backup and of the nightly check, "today", and the dates in the exports and the log use it. An unknown
# name stops the start of the tool (the log shows the error).
TIME_ZONE=

# ---- Uploaded files (in MB)
MAX_EVIDENCE_SIZE_MB=5
MAX_IMPORT_SIZE_MB=10
# An Excel file is compressed: it is refused, before it is opened, above this size once uncompressed
# (empty = 20 times MAX_IMPORT_SIZE_MB, that is 200 MB; a real workbook is 10 to 17 times larger once uncompressed)
MAX_XLSX_UNCOMPRESSED_MB=
# Backup uploaded from the tool (Hosting › Restore) by an administrator; every other upload is limited to the larger of
# the two sizes above (plus 1 MB). With the Caddy proxy, CADDY_MAX_SIZE also applies.
MAX_BACKUP_UPLOAD_MB=2048
# Value imports above this number of rows run in the background (progress bar, the page can be left);
# below it, nothing changes. 0 = never (the import is done within the page, which may last 120 s at most)
BACKGROUND_IMPORT_ROWS=5000
# /sante/ answers 503 ("disk almost full") below this free space on the data disk (in MB)
DISK_ALERT_MB=100

# ---- Backups (in /data/backups)
# Starting values: afterwards, enabling, frequency, time and number kept are set in the tool
# (Administration › Settings › Hosting). Time in the TIME_ZONE time zone (see "Time zone").
BACKUP_AUTO=1
BACKUP_TIME=02:30
# Number of archives kept (the oldest are deleted).
BACKUPS_KEEP=14

# ---- Data check (consistency of the database, read only; result in Settings › Hosting and /sante/)
# Time of the nightly check of each space ("check_data --schedule"), TIME_ZONE time zone.
DATA_CHECK_TIME=03:30

# ---- Server
# gunicorn worker processes and threads; request timeout in seconds. Empty GUNICORN_WORKERS: one per processor, from
# 2 to 4 (about 170 MB of memory each). Capacity: docs/installation.md, section 8.
GUNICORN_WORKERS=
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
# Seconds an idle connection stays open; keep it above the idle timeout of the proxy in front of the tool (Caddy: 60 s).
GUNICORN_KEEPALIVE=75
# Log level: INFO, WARNING, ERROR
DJANGO_LOG_LEVEL=INFO
# Published image to use instead of the local build (e.g. ghcr.io/probant-reporting/probant:latest).
IMAGE=

# ---- Advanced (rarely needed; empty = default)
# Exact list of accepted host names / trusted origins, instead of the one derived from DOMAIN (e.g. behind a proxy).
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# PostgreSQL without DATABASE_URL: POSTGRES_DB (enables it), POSTGRES_USER (default probant), POSTGRES_HOST (default db),
# POSTGRES_PORT (default 5432) and POSTGRES_PASSWORD above.
# Other folders than those of the data volume (/data): uploaded files, backups, other spaces.
# MEDIA_ROOT=  BACKUPS_DIR=  SPACES_DIR=
# Name of the SQLite file in the data folder (default db.sqlite3). The file of the shared accounts and the folder of the
# spaces take the same prefix. Used by the demos and the tests; leave it empty in production.
# SQLITE_FILE=
# Seconds that the connection to the database of a space stays open between two requests (default 60).
# SPACES_CONN_MAX_AGE=60
# Maximum size of a request accepted by Caddy ("https" profile).
# CADDY_MAX_SIZE=50MB
